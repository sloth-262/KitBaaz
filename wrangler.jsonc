{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "kitbaaz",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Last copy of the prices and payment details read from the Google Sheet,
	// so pages load fast and keep working if the Sheet is slow. Created on deploy.
	"kv_namespaces": [{ "binding": "SITE_CACHE" }],
	"observability": {
		"enabled": true
	}
}