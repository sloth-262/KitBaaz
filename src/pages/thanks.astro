---
import Base from '../layouts/Base.astro';
import { site, whatsappLink } from '../data/site';
import TestPriceNote from '../components/TestPriceNote.astro';
import { activeProducts, orderableProducts } from '../data/products';
import { toBnDigits } from '../lib/bn';

const advancePct = toBnDigits(site.advancePercent);
const days = `${toBnDigits(site.deliveryDays.min)}–${toBnDigits(site.deliveryDays.max)}`;
const wa = whatsappLink();
const pageData = JSON.stringify({
  payments: site.payments,
  kits: Object.fromEntries(activeProducts().map((k) => [k.slug, k.nameBn])),
  whatsapp: site.whatsapp,
});
---

<Base title="ধন্যবাদ" noindex>
  <section class="section thanks">
    <div class="container thanks__inner" id="thanks" data-page={pageData}>
      <div class="thanks__icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="56" height="56">
          <circle cx="24" cy="24" r="24" fill="#0b7a75"></circle>
          <path d="M14 25l7 7 13-15" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <h1>ধন্যবাদ! আপনার প্রি-অর্ডার পেয়েছি</h1>

      <div class="card order-id" id="order-box" hidden>
        <span>অর্ডার নম্বর</span>
        <strong id="order-id"></strong>
        <span class="order-id__kit" id="order-kit"></span>
      </div>

      <div class="card step">
        <h2>১. {advancePct}% অগ্রিম পাঠান</h2>
        {orderableProducts().some((k) => k.testPrice) && <TestPriceNote />}
        <div id="amounts" hidden>
          <div class="row"><span>মোট দাম</span><strong id="amt-total"></strong></div>
          <div class="row row--big"><span>এখন অগ্রিম ({advancePct}%)</span><strong id="amt-advance"></strong></div>
          <div class="row"><span>বাকি</span><strong id="amt-balance"></strong></div>
        </div>
        <p id="pay-how">
          অর্ডার নিশ্চিত করতে মোট দামের {advancePct}% অগ্রিম পাঠাতে হবে। পেমেন্টের নম্বর আমরা ফোন করে জানিয়ে দেব।
        </p>
        <dl class="bank" id="bank-details" hidden></dl>
        <p class="muted">পেমেন্টের রেফারেন্সে আপনার অর্ডার নম্বরটি লিখুন।</p>
      </div>

      <div class="card step claim" id="claim" hidden>
        <h2 id="claim-title">টাকা পাঠিয়েছেন? TrxID দিন</h2>
        <p class="muted" id="claim-intro">
          টাকা পাঠানোর পর SMS-এ একটি TrxID (ট্রানজেকশন আইডি) পাবেন। সেটি এখানে দিন, আমরা মিলিয়ে দেখে অর্ডার
          নিশ্চিত করব।
        </p>

        <div class="alert" id="claim-alert" role="alert" hidden></div>

        <form id="claim-form" novalidate>
          <input type="hidden" name="orderId" />
          <input type="hidden" name="key" />
          <input type="hidden" name="method" />
          <div class="hp" aria-hidden="true">
            <label for="claim-website">Website</label>
            <input id="claim-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="field">
            <label for="trxId" id="trxId-label">TrxID</label>
            <input
              id="trxId"
              name="trxId"
              type="text"
              autocapitalize="characters"
              autocomplete="off"
              spellcheck="false"
              placeholder="যেমন: 9K3L2M1N0P"
              maxlength="30"
            />
            <p class="field__error" id="claim-err-trxId" hidden></p>
          </div>

          <div class="field">
            <label for="paidFrom" id="paidFrom-label">যে নম্বর থেকে টাকা পাঠিয়েছেন</label>
            <input id="paidFrom" name="paidFrom" type="tel" inputmode="tel" placeholder="01XXXXXXXXX" maxlength="20" />
            <p class="field__error" id="claim-err-paidFrom" hidden></p>
          </div>

          <button type="submit" class="btn btn--primary btn--block" id="claim-submit">TrxID জমা দিন</button>
        </form>

        <div class="claim__done" id="claim-done" hidden>
          <p><strong id="claim-done-title">ধন্যবাদ! TrxID পেয়েছি।</strong></p>
          <p>আমরা মিলিয়ে দেখে আপনাকে ফোন বা মেসেজে জানাব। ভুল হলে আবার দিতে পারবেন।</p>
          <button type="button" class="btn btn--outline" id="claim-again">আবার দিন</button>
        </div>

        <p class="muted claim__later">এখন টাকা না পাঠালে এই পাতার লিংকটি সেভ করে রাখুন, পরে এসে TrxID দিতে পারবেন।</p>
      </div>

      <div class="card step">
        <h2>২. আমরা ফোন করে নিশ্চিত করব</h2>
        <p>অগ্রিম পাওয়ার পর আমরা আপনার নম্বরে ফোন বা মেসেজ করে অর্ডার নিশ্চিত করব।</p>
      </div>

      <div class="card step">
        <h2>৩. {days} দিনের মধ্যে ডেলিভারি</h2>
        <p>অগ্রিম পাওয়ার পর {days} দিনের মধ্যে কিট আপনার ঠিকানায় পৌঁছে যাবে। প্রতিটি ধাপে আপনাকে জানানো হবে।</p>
      </div>

      <div class="thanks__actions">
        {wa && <a class="btn btn--outline" href={wa} id="wa-link">WhatsApp-এ যোগাযোগ</a>}
        <a class="btn btn--primary" href="/">হোম পেজে ফিরে যান</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { formatTk, toBnDigits } from '../lib/bn';
  import { validatePaymentClaim, type ClaimErrors } from '../lib/order';

  import type { PaymentInfo } from './api/payment-info';

  type Payment = { labelBn: string; howBn: string };
  const root = document.querySelector<HTMLElement>('#thanks')!;
  const page = JSON.parse(root.dataset.page ?? '{}') as {
    payments: Record<string, Payment>;
    kits: Record<string, string>;
    whatsapp: string | null;
  };
  const p = new URLSearchParams(location.search);
  const id = p.get('id');
  const money = (key: string) => {
    const n = Number(p.get(key));
    return Number.isFinite(n) && n > 0 ? n : null;
  };
  const total = money('total');
  const advance = money('advance');
  const set = (sel: string, text: string) => (document.querySelector(sel)!.textContent = text);

  if (id && /^[A-Z0-9-]{4,30}$/.test(id)) {
    set('#order-id', id);
    const kit = page.kits[p.get('kit') ?? ''];
    const qty = Number(p.get('qty'));
    if (kit) set('#order-kit', Number.isInteger(qty) && qty > 0 ? `${kit} · ${toBnDigits(qty)}টি` : kit);
    document.querySelector<HTMLElement>('#order-box')!.hidden = false;

    if (total && advance && advance <= total) {
      set('#amt-total', formatTk(total));
      set('#amt-advance', formatTk(advance));
      set('#amt-balance', formatTk(total - advance));
      document.querySelector<HTMLElement>('#amounts')!.hidden = false;
    }

    const method = p.get('pay') ?? '';
    const pay = page.payments[method];
    if (pay) showPaymentDetails(method, pay);

    const wa = document.querySelector<HTMLAnchorElement>('#wa-link');
    if (wa && page.whatsapp) {
      wa.href = `https://wa.me/${page.whatsapp}?text=${encodeURIComponent(`আমার অর্ডার নম্বর ${id}।`)}`;
    }

    const key = p.get('k');
    if (key && /^[0-9a-f]{12}$/.test(key)) setUpClaim(id, key, method);
  }

  // Where to send the advance. The numbers and bank details are kept in the
  // Sheet and fetched here; if that fails, the customer is told we will call.
  async function showPaymentDetails(method: string, pay: Payment) {
    const fallback = `আপনি ${pay.labelBn} বেছে নিয়েছেন। পেমেন্টের নম্বর আমরা ফোন করে জানিয়ে দেব।`;
    const amount = advance ? `${formatTk(advance)} ` : '';
    set('#pay-how', 'পেমেন্টের তথ্য আনা হচ্ছে…');
    let info: PaymentInfo | null = null;
    try {
      const res = await fetch('/api/payment-info', { headers: { accept: 'application/json' } });
      const data = await res.json();
      if (data.ok) info = data.payments;
    } catch {
      // network problem: fall back below
    }

    if (method === 'bank') {
      const b = info?.bank;
      if (!b?.bankName || !(b.accountNumber || b.cardNumber)) return set('#pay-how', fallback);
      set('#pay-how', `নিচের ব্যাংক অ্যাকাউন্টে ${amount}পাঠান:`);
      const dl = document.querySelector<HTMLElement>('#bank-details')!;
      const rows: [string, string | null][] = [
        ['ব্যাংক', b.bankName],
        ['অ্যাকাউন্টের নাম', b.accountName],
        ['অ্যাকাউন্ট নম্বর', b.accountNumber],
        ['কার্ড নম্বর', b.cardNumber],
        ['শাখা', b.branch],
        ['রাউটিং নম্বর', b.routing],
      ];
      for (const [label, value] of rows) {
        if (!value) continue;
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        dt.textContent = label;
        dd.textContent = value;
        dl.append(dt, dd);
      }
      dl.hidden = false;
      return;
    }

    const number = info?.[method as 'bkash' | 'nagad' | 'rocket']?.number;
    if (!number) return set('#pay-how', fallback);
    set('#pay-how', `${pay.labelBn} নম্বর ${number}-এ ${amount}${pay.howBn ? pay.howBn + ' ' : ''}করুন।`);
  }

  // "Paid already? Enter the TrxID" box. A bank's message has no phone number
  // in it, so bank transfers ask for the reference number and the sender's
  // name and bank instead.
  function setUpClaim(orderId: string, key: string, method: string) {
    const box = document.querySelector<HTMLElement>('#claim')!;
    const form = document.querySelector<HTMLFormElement>('#claim-form')!;
    const done = document.querySelector<HTMLElement>('#claim-done')!;
    const alertBox = document.querySelector<HTMLElement>('#claim-alert')!;
    const submit = document.querySelector<HTMLButtonElement>('#claim-submit')!;
    form.orderId.value = orderId;
    form.key.value = key;
    (form.elements.namedItem('method') as HTMLInputElement).value = method; // form.method is the HTTP method
    const bank = method === 'bank';
    const submitText = bank ? 'তথ্য জমা দিন' : 'TrxID জমা দিন';
    if (bank) {
      set('#claim-title', 'টাকা পাঠিয়েছেন? ট্রানজেকশনের তথ্য দিন');
      set(
        '#claim-intro',
        'ব্যাংক অ্যাপ বা জমার রসিদে একটি ট্রানজেকশন / রেফারেন্স নম্বর থাকে। সেটি আর যার অ্যাকাউন্ট থেকে পাঠিয়েছেন তার নাম ও ব্যাংকের নাম দিন, আমরা ব্যাংক স্টেটমেন্টে মিলিয়ে দেখে অর্ডার নিশ্চিত করব। রসিদের ছবি থাকলে WhatsApp-এ পাঠাতে পারেন।',
      );
      set('#trxId-label', 'ট্রানজেকশন / রেফারেন্স নম্বর');
      set('#paidFrom-label', 'যার অ্যাকাউন্ট থেকে পাঠিয়েছেন (নাম ও ব্যাংক)');
      set('#claim-done-title', 'ধন্যবাদ! তথ্য পেয়েছি।');
      form.trxId.placeholder = 'রসিদ বা ব্যাংক অ্যাপে পাবেন';
      form.paidFrom.type = 'text';
      form.paidFrom.inputMode = 'text';
      form.paidFrom.maxLength = 80;
      form.paidFrom.placeholder = 'যেমন: রহিম উদ্দিন, ডাচ-বাংলা ব্যাংক';
      submit.textContent = submitText;
    } else if (method === 'rocket') {
      set('#paidFrom-label', 'যে রকেট নম্বর থেকে টাকা পাঠিয়েছেন');
      form.paidFrom.placeholder = '01XXXXXXXXXX';
    }
    box.hidden = false;

    const showAlert = (msg: string | null) => {
      alertBox.textContent = msg ?? '';
      alertBox.hidden = !msg;
    };
    const showErrors = (errors: ClaimErrors) => {
      let first: HTMLElement | null = null;
      for (const field of ['trxId', 'paidFrom'] as const) {
        const msg = errors[field];
        const el = document.querySelector<HTMLElement>(`#claim-err-${field}`)!;
        const input = form.elements.namedItem(field) as HTMLInputElement;
        el.textContent = msg ?? '';
        el.hidden = !msg;
        input.toggleAttribute('aria-invalid', Boolean(msg));
        if (msg) input.setAttribute('aria-describedby', el.id);
        if (msg && !first) first = input;
      }
      (first as HTMLElement | null)?.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      showAlert(null);
      const data = Object.fromEntries(new FormData(form));
      const { errors } = validatePaymentClaim(data);
      showErrors(errors);
      if (Object.keys(errors).length > 0) return;

      submit.disabled = true;
      submit.textContent = 'জমা হচ্ছে…';
      try {
        const res = await fetch('/api/payment', {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const result = await res.json();
        if (result.ok) {
          form.hidden = true;
          done.hidden = false;
        } else {
          if (result.fieldErrors) showErrors(result.fieldErrors);
          showAlert(result.message ?? 'তথ্যটি জমা দেওয়া যায়নি। আবার চেষ্টা করুন।');
        }
      } catch {
        showAlert('ইন্টারনেট সংযোগে সমস্যা। সংযোগ দেখে আবার চেষ্টা করুন।');
      }
      submit.disabled = false;
      submit.textContent = submitText;
    });

    document.querySelector('#claim-again')!.addEventListener('click', () => {
      done.hidden = true;
      form.hidden = false;
      form.trxId.focus();
    });
  }
</script>

<style>
  .thanks__inner {
    max-width: 640px;
    display: grid;
    gap: 14px;
  }
  .thanks__icon {
    display: flex;
  }
  .order-id {
    display: grid;
    gap: 2px;
    background: var(--bg-soft);
    border-color: var(--brand);
  }
  .order-id strong {
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    color: var(--brand-dark);
    font-family: ui-monospace, 'Segoe UI', sans-serif;
  }
  .order-id__kit {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .step h2 {
    font-size: 1.15rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    padding: 3px 0;
  }
  .row--big {
    font-size: 1.15rem;
    color: var(--brand-dark);
  }
  #amounts {
    margin-bottom: 12px;
  }
  .bank {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 14px;
    margin: 0 0 12px;
    padding: 12px 14px;
    background: var(--bg-soft);
    border-radius: 10px;
  }
  .bank dt {
    color: var(--ink-soft);
  }
  .bank dd {
    margin: 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .muted {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .claim {
    border-color: var(--accent);
  }
  .claim form {
    display: grid;
    gap: 4px;
  }
  .claim form .btn {
    margin-top: 16px;
  }
  #trxId {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .claim__done {
    background: var(--bg-soft);
    border-radius: 10px;
    padding: 14px 16px;
  }
  .claim__later {
    margin: 14px 0 0;
  }
</style>
