---
import Base from '../layouts/Base.astro';

// Rendered on request, so kit pages (also rendered on request) can show it for an unknown kit.
export const prerender = false;
Astro.response.status = 404;
---

<Base title="পাতাটি পাওয়া যায়নি">
  <section class="section">
    <div class="container">
      <h1>দুঃখিত, পাতাটি পাওয়া যায়নি</h1>
      <p>লিংকটি ভুল হতে পারে, অথবা পাতাটি সরিয়ে নেওয়া হয়েছে।</p>
      <a class="btn btn--primary" href="/">হোম পেজে ফিরে যান</a>
    </div>
  </section>
</Base>
