---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p><strong>{site.name}</strong> · {site.tagline}</p>
    <p class="site-footer__note">
      ওয়েবসাইটের ছবিগুলো প্রতীকী। আসল কিটের ছবি শীঘ্রই যোগ করা হবে।
    </p>
    <p class="site-footer__note">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #e6eeec;
    padding: 32px 0 40px;
    font-size: 0.95rem;
  }
  .site-footer__note {
    color: #a9bab7;
    font-size: 0.88rem;
    margin-bottom: 0.4em;
  }
</style>
