// Placeholder text logo until KitBaaz has a final logo.
---

<span class="logo">
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
    <rect x="3" y="7" width="26" height="20" rx="6" fill="#0b7a75"></rect>
    <circle cx="11.5" cy="17" r="3" fill="#fff"></circle>
    <circle cx="20.5" cy="17" r="3" fill="#fff"></circle>
    <rect x="14.5" y="1.5" width="3" height="6" rx="1.5" fill="#f28c28"></rect>
  </svg>
  <span class="logo__text">Kit<span>Baaz</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--ink);
    line-height: 1;
  }
  .logo__text span {
    color: var(--brand);
  }
</style>
